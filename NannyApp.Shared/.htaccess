# This folder holds DB credentials and raw uploaded files; it must never be
# served directly. It's read by NannyApp.Web via PHP includes/media.php, not
# by the browser. If deployed under the same docroot as NannyApp.Web
# (e.g. htdocs/NannyApp.Shared next to htdocs/nannyapp), block it entirely:

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

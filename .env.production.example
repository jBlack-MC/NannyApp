# Copy these values into your host's secret/environment configuration. Never commit real values.
NANNYAPP_BASE_URL=
NANNYAPP_DB_HOST=
NANNYAPP_DB_PORT=3306
NANNYAPP_DB_NAME=
NANNYAPP_DB_USER=
NANNYAPP_DB_PASS=
NANNYAPP_SUPPORT_EMAIL=
NANNYAPP_SUPPORT_PHONE=
NANNYAPP_STORAGE_DRIVER=local
# Absolute private persistent upload directory (blank uses Shared/storage).
NANNYAPP_STORAGE_DIR=
NANNYAPP_STORAGE_QUOTA_BYTES=104857600
NANNYAPP_STORAGE_RESERVE_BYTES=20971520
NANNYAPP_S3_BUCKET=
NANNYAPP_S3_REGION=
NANNYAPP_S3_ACCESS_KEY=
NANNYAPP_S3_SECRET_KEY=
NANNYAPP_S3_ENDPOINT=
NANNYAPP_S3_PUBLIC_BASE_URL=
# PHP mail() uses the host-configured MTA; SMTP_* values are not consumed by this app.
NANNYAPP_MAIL_TRANSPORT=mail
NANNYAPP_MAIL_FROM=
# Optional queued account email delivery. Apply migrate_v7_email_outbox.sql,
# set MAIL_TRANSPORT=resend, and schedule Shared/bin/send-email.php every minute.
# Supply this in server environment only, never in Android or checked-in files.
NANNYAPP_RESEND_API_KEY=
# BASE_URL above must be an absolute HTTPS web portal URL for email links.
# Keep the entire S3 bucket private; public/CDN URLs are not used for documents.

# Absolute path to a signed Android release outside the public web root.
# Leave empty until a tested production APK is ready; never publish debug builds.
NANNYAPP_APK_PATH=
